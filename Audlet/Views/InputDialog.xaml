<Window x:Class="Audlet.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Border Style="{StaticResource GlassPanel}" CornerRadius="0" BorderThickness="0" Padding="24" MinWidth="420">
        <StackPanel>
            <TextBlock x:Name="Prompt" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBox x:Name="Input" AutomationProperties.AutomationId="InputText" FontSize="14" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource GlassButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="Ok" AutomationProperties.AutomationId="InputOk" Style="{StaticResource PillButton}" Content="OK" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
