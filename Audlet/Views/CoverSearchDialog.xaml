<Window x:Class="Audlet.Views.CoverSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:Audlet.Library"
        Title="Find cover online" Width="860" Height="620" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border Style="{StaticResource GlassPanel}" CornerRadius="0" BorderThickness="0" Padding="20">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" Margin="0,0,8,0" ToolTip="Title" />
                    <TextBox x:Name="AuthorBox" Grid.Column="1" Margin="0,0,8,0" ToolTip="Author" />
                    <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="Search" Click="Search_Click" IsDefault="True" />
                </Grid>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" x:Name="UseButton" Style="{StaticResource PillButton}" Content="Use this cover" Click="Use_Click" IsEnabled="False" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
                    <CheckBox x:Name="UseDescription" Content="Also use the description as the book blurb" IsChecked="True" VerticalAlignment="Center" Foreground="{DynamicResource GlassTextBrush}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="Status" Foreground="{DynamicResource GlassMutedBrush}" Margin="0,0,0,8" Text="Searching Audible, Apple Books, Open Library and Google Books..." />
                <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" SelectionChanged="Results_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Background="{DynamicResource GlassBrush}" Padding="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassHoverBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type lib:CoverCandidate}">
                            <StackPanel Width="150">
                                <Border Height="200" CornerRadius="6" Background="{DynamicResource GlassBorderBrush}">
                                    <Image Source="{Binding ImageUrl}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Foreground="{DynamicResource GlassTextBrush}" />
                                <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource GlassMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource GlassMutedBrush}" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource GlassMutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="48" Margin="0,4,0,0" ToolTip="{Binding Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
