<UserControl x:Class="Audlet.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Audlet.Converters"
             xmlns:vm="clr-namespace:Audlet.ViewModels">
    <UserControl.Resources><c:FractionOfWidth x:Key="FractionOfWidth" /></UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextBrush}" Margin="0,0,0,16"><Run Text="Statistics - " /><Run Text="{Binding TotalListened, Mode=OneWay}" /></TextBlock>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource GlassPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Months}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonthRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Month}" />
                                    <Border x:Name="Track" Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource GlassBorderBrush}" Margin="8,0">
                                        <Border CornerRadius="5" Background="{DynamicResource AccentFillBrush}" HorizontalAlignment="Left">
                                            <Border.Width><MultiBinding Converter="{StaticResource FractionOfWidth}" Mode="OneWay"><Binding Path="Fraction" /><Binding ElementName="Track" Path="ActualWidth" /></MultiBinding></Border.Width>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Listened}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BookRow}">
                                <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Listened}" /><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
