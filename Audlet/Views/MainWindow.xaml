<Window x:Class="Audlet.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Audlet.Converters"
        Title="Audlet" Width="1200" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:NullToVisibility x:Key="NotNull" />
        <c:TimeConverter x:Key="Time" />
        <c:RemainingConverter x:Key="Remaining" />
        <c:PercentConverter x:Key="Percent" />
        <c:PlayGlyph x:Key="PlayGlyph" />
        <c:CoverImage x:Key="Cover" />
        <c:CoverImage x:Key="CoverFull" Full="True" />
        <c:SleepGlyph x:Key="SleepGlyph" />
    </Window.Resources>
    <Grid>
        <!-- Themed backdrop the glass panels sit on: a gradient with soft colour orbs, so the frosted panels have something to sit over -->
        <Rectangle Fill="{DynamicResource BackgroundBrush}" />
        <Canvas ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse Width="900" Height="900" Canvas.Left="-120" Canvas.Top="-380" Fill="{DynamicResource Orb1Brush}" />
            <Ellipse Width="820" Height="820" Canvas.Right="-260" Canvas.Top="-40" Fill="{DynamicResource Orb2Brush}" />
            <Ellipse Width="760" Height="760" Canvas.Left="300" Canvas.Bottom="-420" Fill="{DynamicResource Orb3Brush}" />
        </Canvas>

        <Grid Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="220" MinWidth="160" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GlassPanel}" CornerRadius="0" BorderThickness="0,0,1,0" Grid.RowSpan="2">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Style="{StaticResource NavCaption}" Content="LIBRARY" />
                    <ListBoxItem Tag="Library" Content="All books" />
                    <ListBoxItem Tag="Started" Content="Started" />
                    <ListBoxItem Tag="New" Content="New" />
                    <ListBoxItem Tag="Finished" Content="Finished" />
                    <ListBoxItem Tag="Queue" Content="Queue" />
                    <ListBoxItem Style="{StaticResource NavCaption}" Content="MORE" />
                    <ListBoxItem Tag="Bookmarks" Content="Bookmarks" />
                    <ListBoxItem Tag="Statistics" Content="Statistics" />
                    <ListBoxItem Tag="Settings" Content="Settings" />
                </ListBox>
            </Border>
            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" Background="Transparent" HorizontalAlignment="Center" DragCompleted="Sidebar_DragCompleted" />

            <ContentControl x:Name="Content" Grid.Column="2" Margin="{StaticResource Gutter}" />

            <!-- Player bar -->
            <Border x:Name="PlayerBar" Grid.Column="2" Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="24,0,24,24" Padding="16,12" Cursor="Hand"
                    Visibility="Collapsed" MouseLeftButtonUp="PlayerBar_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="6" Margin="0,0,16,0">
                        <Border.Background><ImageBrush ImageSource="{Binding Controller.CurrentBook.CoverPath, Converter={StaticResource Cover}}" Stretch="UniformToFill" /></Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Controller.CurrentBook.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{DynamicResource GlassMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Controller.CurrentChapter.Title, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Controller.Speed, Mode=OneWay, StringFormat={}{0:0.00}x}" /><Run Text=" - " />
                            <Run><Run.Text><MultiBinding Converter="{StaticResource Remaining}" Mode="OneWay"><Binding Path="Controller.BookPositionSec" /><Binding Path="Controller.BookTotalSec" /></MultiBinding></Run.Text></Run>
                        </TextBlock>
                        <ProgressBar Height="3" Margin="0,6,0,0" Maximum="100" Background="{DynamicResource GlassBorderBrush}" Foreground="{DynamicResource AccentFillBrush}" BorderThickness="0">
                            <ProgressBar.Value><MultiBinding Converter="{StaticResource Percent}" Mode="OneWay"><Binding Path="Controller.BookPositionSec" /><Binding Path="Controller.BookTotalSec" /></MultiBinding></ProgressBar.Value>
                        </ProgressBar>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Store.Settings.BigRewindSec}" ContentStringFormat="-{0}" Click="BigBack_Click" ToolTip="Big rewind" />
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Store.Settings.SmallRewindSec}" ContentStringFormat="-{0}" Click="SmallBack_Click" Margin="8,0" ToolTip="Rewind" />
                        <Button AutomationProperties.AutomationId="BarPlay" Style="{StaticResource PlayButton}" Width="48" Height="48" FontSize="18" Content="{Binding Controller.IsPlaying, Converter={StaticResource PlayGlyph}}" Click="Play_Click" />
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Store.Settings.SmallRewindSec}" ContentStringFormat="+{0}" Click="SmallFwd_Click" Margin="8,0" ToolTip="Forward" />
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Store.Settings.BigRewindSec}" ContentStringFormat="+{0}" Click="BigFwd_Click" ToolTip="Big forward" />
                    </StackPanel>
                    <Button Grid.Column="3" AutomationProperties.AutomationId="BarSpeed" Style="{StaticResource GlassButton}" Content="{Binding Controller.Speed}" ContentStringFormat="{}{0:0.00}x" Click="Speed_Click" ToolTip="Speed: click to cycle 1x, 1.25x, 1.5x, 1.75x, 2x" Margin="0,0,8,0" MinWidth="64" />
                    <Button Grid.Column="4" AutomationProperties.AutomationId="BarSleep" Style="{StaticResource GlassButton}" Click="Sleep_Click" ToolTip="Sleep timer" Padding="10,6">
                        <TextBlock><Run FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE708;" /><Run Text="{Binding Controller.SleepRemaining, Mode=OneWay, Converter={StaticResource SleepGlyph}}" /></TextBlock>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Update banner -->
        <Border Style="{StaticResource GlassPanel}" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0"
                Visibility="{Binding Update, Converter={StaticResource NotNull}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"><Run Text="Audlet " /><Run Text="{Binding Update.Version, Mode=OneWay}" /><Run Text=" is available." /></TextBlock>
                <Button Style="{StaticResource PillButton}" Content="Download" Command="{Binding OpenUpdateCommand}" Margin="0,0,6,0" />
                <Button Style="{StaticResource GlassButton}" Content="Later" Command="{Binding DismissUpdateCommand}" />
            </StackPanel>
        </Border>
        <!-- Wake prompt after the sleep timer faded the book out -->
        <Grid Visibility="{Binding Controller.DozePromptVisible, Converter={StaticResource Vis}}">
            <Rectangle Fill="{DynamicResource ScrimBrush}" />
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{StaticResource GlassRadius}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <Border Style="{StaticResource GlassPanel}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Rewind to where you dozed off?" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,14" Foreground="{DynamicResource GlassMutedBrush}" TextWrapping="Wrap" Text="The sleep timer faded the book out. You can jump back to where the fade began, or keep going from here." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GlassButton}" Content="Keep going" Click="DozeKeep_Click" Margin="0,0,8,0" />
                    <Button AutomationProperties.AutomationId="DozeRewind" Style="{StaticResource PillButton}" Content="Rewind" Click="DozeRewind_Click" />
                </StackPanel>
            </StackPanel>
            </Border>
            </Border>
        </Grid>
        <TextBlock Text="Audlet" Margin="16,12,0,0" VerticalAlignment="Top" Foreground="{DynamicResource GlassMutedBrush}" FontSize="12" IsHitTestVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
        </StackPanel>
        <Border Style="{StaticResource GlassPanel}" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0"
                Visibility="{Binding Toast, Converter={StaticResource NotNull}}">
            <TextBlock AutomationProperties.AutomationId="Toast" Text="{Binding Toast}" />
        </Border>
        <Border Style="{StaticResource GlassPanel}" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,24,0"
                Visibility="{Binding IsScanning, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding ScanStatus, StringFormat=Scanning {0}}" />
        </Border>
    </Grid>
</Window>
