<UserControl x:Class="WindowsAudiobookPlayer.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsAudiobookPlayer.Converters"
             xmlns:v="clr-namespace:WindowsAudiobookPlayer.Views"
             xmlns:vm="clr-namespace:WindowsAudiobookPlayer.ViewModels"
             xmlns:m="clr-namespace:WindowsAudiobookPlayer.Models">
    <UserControl.Resources>
        <c:TimeConverter x:Key="Time" />
        <c:RemainingConverter x:Key="Remaining" />
        <c:BoolToVisibility x:Key="Vis" />
        <c:BoolToVisibility x:Key="Hid" Invert="True" />
        <c:CoverImage x:Key="Cover" Full="True" />
        <c:PlayGlyph x:Key="PlayGlyph" />
        <c:LockGlyph x:Key="LockGlyph" />
        <c:InverseBool x:Key="InverseBool" />
        <c:LocalTime x:Key="LocalTime" />
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="10,7" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,1" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="1*" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="RightCol" Width="2*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Left: tabs panel -->
        <Border Style="{StaticResource GlassPanel}" Grid.RowSpan="2">
            <DockPanel>
                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12">
                    <RadioButton Style="{StaticResource Tab}" Content="Chapters" IsChecked="True" Checked="Tab_Checked" Tag="0" />
                    <RadioButton Style="{StaticResource Tab}" Content="Bookmarks" Checked="Tab_Checked" Tag="1" />
                    <RadioButton Style="{StaticResource Tab}" Content="History" Checked="Tab_Checked" Tag="2" />
                </UniformGrid>
                <Grid>
                    <ScrollViewer x:Name="ChaptersPane" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Chapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChapterRow}">
                                    <Border Style="{StaticResource Row}" MouseLeftButtonUp="Chapter_Click">
                                        <Border.Resources>
                                            <Style TargetType="TextBlock"><Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                            </Style.Triggers></Style>
                                        </Border.Resources>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" Foreground="{DynamicResource GlassMutedBrush}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Chapter.Title}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <DockPanel x:Name="BookmarksPane" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="Add" Command="{Binding AddBookmarkCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Bookmark}">
                                        <Border Style="{StaticResource Row}" MouseLeftButtonUp="Bookmark_Click">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Padding="6,2" Content="&#x2715;"
                                                        Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Foreground="{DynamicResource GlassMutedBrush}" FontSize="11"><Run Text="{Binding PositionSec, Mode=OneWay, Converter={StaticResource Time}}" /><Run Text=" - file " /><Run Text="{Binding FileIndex, Mode=OneWay}" /></TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    <ScrollViewer x:Name="HistoryPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:HistoryEntry}">
                                    <Border Style="{StaticResource Row}" MouseLeftButtonUp="History_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AtUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" Foreground="{DynamicResource GlassMutedBrush}" />
                                            <TextBlock><Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding PositionSec, Mode=OneWay, Converter={StaticResource Time}}" /></TextBlock>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="24" Background="Transparent" HorizontalAlignment="Center" DragCompleted="Splitter_DragCompleted" />

        <!-- Right top: cover -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Border Width="280" Height="280" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.5" /></Border.Effect>
                <Border.Background><ImageBrush ImageSource="{Binding Controller.CurrentBook.CoverPath, Converter={StaticResource Cover}}" Stretch="UniformToFill" /></Border.Background>
            </Border>
            <TextBlock Text="{Binding Controller.CurrentBook.Title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextBrush}" Margin="0,20,0,4" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            <TextBlock Text="{Binding Controller.CurrentBook.Author}" Foreground="{DynamicResource GlassMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Right bottom: controls -->
        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="24,16">
            <StackPanel>
                <Slider x:Name="Seek" Style="{StaticResource GlassSlider}" Maximum="{Binding ShownTotal, Mode=OneWay}" Value="{Binding ShownPosition, Mode=OneWay}"
                        Thumb.DragCompleted="Seek_DragCompleted" PreviewMouseLeftButtonUp="Seek_Click" IsEnabled="{Binding Controller.Locked, Converter={StaticResource InverseBool}}" />
                <Grid Margin="0,4,0,12">
                    <TextBlock Text="{Binding ShownPosition, Converter={StaticResource Time}}" HorizontalAlignment="Left" />
                    <Button Style="{StaticResource GlassButton}" Padding="8,2" Background="Transparent" HorizontalAlignment="Center" Command="{Binding TogglePositionModeCommand}" ToolTip="Switch between file and book position">
                        <TextBlock Text="{Binding ChapterLabel}" Foreground="{DynamicResource GlassMutedBrush}" />
                    </Button>
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource GlassMutedBrush}">
                        <TextBlock.Text><MultiBinding Converter="{StaticResource Remaining}" Mode="OneWay"><Binding Path="ShownPosition" /><Binding Path="ShownTotal" /></MultiBinding></TextBlock.Text>
                    </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Controller.Locked, Converter={StaticResource Hid}}">
                        <Button Style="{StaticResource TransportButton}" Content="&#x23EE;" Click="PrevFile_Click" Margin="0,0,10,0" Visibility="{Binding Settings.ShowPrevNextFile, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Settings.BigRewindSec}" ContentStringFormat="-{0}" Click="BigBack_Click" Margin="0,0,10,0" />
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Settings.SmallRewindSec}" ContentStringFormat="-{0}" Click="SmallBack_Click" Margin="0,0,10,0" />
                    </StackPanel>
                    <Button Style="{StaticResource PlayButton}" Content="{Binding Controller.IsPlaying, Converter={StaticResource PlayGlyph}}" Click="Play_Click" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Controller.Locked, Converter={StaticResource Hid}}">
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Settings.SmallRewindSec}" ContentStringFormat="+{0}" Click="SmallFwd_Click" Margin="10,0,0,0" />
                        <Button Style="{StaticResource TransportButton}" Content="{Binding Settings.BigRewindSec}" ContentStringFormat="+{0}" Click="BigFwd_Click" Margin="10,0,0,0" />
                        <Button Style="{StaticResource TransportButton}" Content="&#x23ED;" Click="NextFile_Click" Margin="10,0,0,0" Visibility="{Binding Settings.ShowPrevNextFile, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="{Binding Controller.Speed}" ContentStringFormat="{}{0:0.00}x" Click="Speed_Click" Visibility="{Binding Controller.Locked, Converter={StaticResource Hid}}" />
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="{Binding SleepLabel}" Click="Sleep_Click" />
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="Bookmark" Click="QuickBookmark_Click" />
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="EQ" Click="Eq_Click" Visibility="{Binding Controller.Locked, Converter={StaticResource Hid}}" />
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="Boost" Click="Boost_Click" Visibility="{Binding Controller.Locked, Converter={StaticResource Hid}}" />
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="Characters" Click="Characters_Click" />
                    <Button Style="{StaticResource PillButton}" Margin="4,0" Content="{Binding Controller.Locked, Converter={StaticResource LockGlyph}}" Command="{Binding ToggleLockCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Popups -->
        <Popup x:Name="SpeedPopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
            <Border Style="{StaticResource GlassPanel}">
                <StackPanel Width="260">
                    <Slider Style="{StaticResource GlassSlider}" Minimum="0.5" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Controller.Speed, Mode=OneWay}" ValueChanged="SpeedSlider_Changed" />
                    <ItemsControl ItemsSource="{Binding SpeedChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GlassButton}" Margin="2" Content="{Binding}" ContentStringFormat="{}{0:0.00}x" Command="{Binding DataContext.SpeedPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GlassButton}" Margin="0,8,0,0" Content="Use as default" Command="{Binding SetDefaultSpeedCommand}" />
                    <TextBlock Margin="0,12,0,0" Text="Pitch (semitones)" Foreground="{DynamicResource GlassMutedBrush}" />
                    <Slider Style="{StaticResource GlassSlider}" Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Pitch}" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="SleepPopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
            <Border Style="{StaticResource GlassPanel}">
                <StackPanel Width="220">
                    <ItemsControl ItemsSource="{Binding SleepChoices}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GlassButton}" Margin="2" Content="{Binding}" ContentStringFormat="{}{0} min" Command="{Binding DataContext.SleepPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GlassButton}" Margin="0,8,0,0" Content="End of chapter" Command="{Binding SleepChapterEndCommand}" />
                    <Button Style="{StaticResource GlassButton}" Margin="0,4,0,0" Content="Off" Command="{Binding StopSleepCommand}" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="EqPopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
            <Border Style="{StaticResource GlassPanel}">
                <StackPanel Width="300">
                    <UniformGrid Columns="5" Height="140">
                        <Slider Orientation="Vertical" Minimum="-15" Maximum="15" Value="{Binding Eq0}" ToolTip="60 Hz" />
                        <Slider Orientation="Vertical" Minimum="-15" Maximum="15" Value="{Binding Eq1}" ToolTip="230 Hz" />
                        <Slider Orientation="Vertical" Minimum="-15" Maximum="15" Value="{Binding Eq2}" ToolTip="910 Hz" />
                        <Slider Orientation="Vertical" Minimum="-15" Maximum="15" Value="{Binding Eq3}" ToolTip="3.6 kHz" />
                        <Slider Orientation="Vertical" Minimum="-15" Maximum="15" Value="{Binding Eq4}" ToolTip="14 kHz" />
                    </UniformGrid>
                    <UniformGrid Columns="5"><TextBlock Text="60" HorizontalAlignment="Center" /><TextBlock Text="230" HorizontalAlignment="Center" /><TextBlock Text="910" HorizontalAlignment="Center" /><TextBlock Text="3.6k" HorizontalAlignment="Center" /><TextBlock Text="14k" HorizontalAlignment="Center" /></UniformGrid>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource GlassButton}" Margin="2" Content="Reset" Command="{Binding ResetEqCommand}" />
                        <Button Style="{StaticResource GlassButton}" Margin="2" Content="Use as default" Command="{Binding SetDefaultEqCommand}" />
                    </UniformGrid>
                    <TextBlock Margin="0,12,0,0" Text="Skip start / end of each file (seconds)" Foreground="{DynamicResource GlassMutedBrush}" />
                    <UniformGrid Columns="2"><TextBox Text="{Binding SkipStart}" Margin="2" /><TextBox Text="{Binding SkipEnd}" Margin="2" /></UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="BoostPopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
            <Border Style="{StaticResource GlassPanel}">
                <StackPanel Width="220">
                    <TextBlock Text="{Binding Boost, StringFormat={}Boost {0:0} dB}" />
                    <Slider Style="{StaticResource GlassSlider}" Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Boost}" />
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="CharactersPopup" StaysOpen="False" Placement="Mouse" AllowsTransparency="True">
            <Border Style="{StaticResource GlassPanel}">
                <v:CharactersView x:Name="CharactersPane" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
