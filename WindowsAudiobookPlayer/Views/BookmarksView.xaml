<UserControl x:Class="WindowsAudiobookPlayer.Views.BookmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsAudiobookPlayer.Converters"
             xmlns:vm="clr-namespace:WindowsAudiobookPlayer.ViewModels">
    <UserControl.Resources><c:TimeConverter x:Key="Time" /></UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Bookmarks" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextBrush}" Margin="0,0,0,16" />
        <Border Style="{StaticResource GlassPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BookmarkRow}">
                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" MouseLeftButtonUp="Row_Click">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Padding="6,2" Content="&#x2715;"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Book.Title, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Bookmark.PositionSec, Mode=OneWay, Converter={StaticResource Time}}" /></TextBlock>
                                        <TextBlock Text="{Binding Bookmark.Note}" Foreground="{DynamicResource GlassMutedBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
