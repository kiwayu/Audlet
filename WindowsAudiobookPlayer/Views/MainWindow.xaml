<Window x:Class="WindowsAudiobookPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WindowsAudiobookPlayer.Converters"
        Title="Audiobook Player" Width="1200" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:NullToVisibility x:Key="NotNull" />
        <c:TimeConverter x:Key="Time" />
        <c:RemainingConverter x:Key="Remaining" />
        <c:PercentConverter x:Key="Percent" />
        <c:PlayGlyph x:Key="PlayGlyph" />
        <c:CoverImage x:Key="Cover" />
        <c:CoverImage x:Key="CoverFull" Full="True" />
    </Window.Resources>
    <Grid>
        <!-- Blurred cover backdrop -->
        <Grid Visibility="{Binding Controller.CurrentBook, Converter={StaticResource NotNull}}">
            <Image Source="{Binding Controller.CurrentBook.CoverPath, Converter={StaticResource CoverFull}}" Stretch="UniformToFill" Opacity="0.9">
                <Image.Effect><BlurEffect Radius="90" KernelType="Gaussian" RenderingBias="Performance" /></Image.Effect>
            </Image>
            <Rectangle Fill="{DynamicResource ScrimBrush}" />
        </Grid>

        <Grid Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="220" MinWidth="160" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource GlassPanel}" CornerRadius="0" BorderThickness="0,0,1,0" Grid.RowSpan="2">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="Library" Content="Library" />
                    <ListBoxItem Tag="Started" Content="Started" />
                    <ListBoxItem Tag="New" Content="New" />
                    <ListBoxItem Tag="Finished" Content="Finished" />
                    <ListBoxItem Tag="Queue" Content="Queue" />
                    <ListBoxItem Tag="Bookmarks" Content="Bookmarks" Margin="0,16,0,2" />
                    <ListBoxItem Tag="Statistics" Content="Statistics" />
                    <ListBoxItem Tag="Settings" Content="Settings" />
                </ListBox>
            </Border>
            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" Background="Transparent" HorizontalAlignment="Center" DragCompleted="Sidebar_DragCompleted" />

            <ContentControl x:Name="Content" Grid.Column="2" Margin="{StaticResource Gutter}" />

            <!-- Player bar -->
            <Border x:Name="PlayerBar" Grid.Column="2" Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="24,0,24,24" Padding="16,12" Cursor="Hand"
                    Visibility="Collapsed" MouseLeftButtonUp="PlayerBar_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="6" Margin="0,0,16,0">
                        <Border.Background><ImageBrush ImageSource="{Binding Controller.CurrentBook.CoverPath, Converter={StaticResource Cover}}" Stretch="UniformToFill" /></Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Controller.CurrentBook.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{DynamicResource GlassMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Controller.CurrentChapter.Title, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Controller.Speed, Mode=OneWay, StringFormat={}{0:0.00}x}" /><Run Text=" - " />
                            <Run><Run.Text><MultiBinding Converter="{StaticResource Remaining}" Mode="OneWay"><Binding Path="Controller.BookPositionSec" /><Binding Path="Controller.BookTotalSec" /></MultiBinding></Run.Text></Run>
                        </TextBlock>
                        <ProgressBar Height="3" Margin="0,6,0,0" Maximum="100" Background="{DynamicResource GlassBorderBrush}" Foreground="{DynamicResource GlassTextBrush}" BorderThickness="0">
                            <ProgressBar.Value><MultiBinding Converter="{StaticResource Percent}" Mode="OneWay"><Binding Path="Controller.BookPositionSec" /><Binding Path="Controller.BookTotalSec" /></MultiBinding></ProgressBar.Value>
                        </ProgressBar>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Content="&#x00AB;" Click="BigBack_Click" />
                        <Button Style="{StaticResource TransportButton}" Content="&#x2039;" Click="SmallBack_Click" Margin="8,0" />
                        <Button Style="{StaticResource PlayButton}" Width="44" Height="44" FontSize="16" Content="{Binding Controller.IsPlaying, Converter={StaticResource PlayGlyph}}" Click="Play_Click" />
                        <Button Style="{StaticResource TransportButton}" Content="&#x203A;" Click="SmallFwd_Click" Margin="8,0" />
                        <Button Style="{StaticResource TransportButton}" Content="&#x00BB;" Click="BigFwd_Click" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource GlassButton}" Content="&#x263E;" Click="Sleep_Click" ToolTip="Sleep timer" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Text="Audiobook Player" Margin="16,12,0,0" VerticalAlignment="Top" Foreground="{DynamicResource GlassMutedBrush}" FontSize="12" IsHitTestVisible="False" />
        <Border Style="{StaticResource GlassPanel}" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0"
                Visibility="{Binding Toast, Converter={StaticResource NotNull}}">
            <TextBlock Text="{Binding Toast}" />
        </Border>
        <Border Style="{StaticResource GlassPanel}" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,24,0"
                Visibility="{Binding IsScanning, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding ScanStatus, StringFormat=Scanning {0}}" />
        </Border>
    </Grid>
</Window>
